    <Authors>amarinne</Authors>
    <Version>0.2.0.0</Version>
    <Description>Read-only game state for a local desktop dashboard.</Description>
    <DalamudPluginManifest>XivCompanionBridge.json</DalamudPluginManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
